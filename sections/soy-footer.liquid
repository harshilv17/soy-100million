{{ 'soy-footer.css' | asset_url | stylesheet_tag }}

<footer class="soy soy-footer">
  <div class="soy-container">
    <div class="soy-footer__top">
      <div class="soy-footer__brand">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 360 | image_tag: alt: shop.name, loading: 'lazy', style: 'max-height:38px;width:auto;' }}
        {%- else -%}
          <span class="soy-footer__brand-word">{{ section.settings.logo_text | default: shop.name }}</span>
          {%- if section.settings.logo_subtitle != blank -%}
            <span class="soy-footer__brand-sub">{{ section.settings.logo_subtitle }}</span>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}
          <p class="soy-footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
        {%- if section.settings.whatsapp_link != blank -%}
          <a href="{{ section.settings.whatsapp_link }}" class="soy-footer__wa" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.7-1.2-4.4-3.9-4.5-4.1-.1-.2-1.1-1.4-1.1-2.6s.6-1.8.9-2.1c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.4.5c-.1.2-.3.3-.1.6.1.3.6 1 1.3 1.6.9.8 1.6 1 1.9 1.2.2.1.4.1.5-.1l.6-.7c.2-.2.3-.2.6-.1l1.8.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z"/></svg>
            {{ section.settings.whatsapp_label }}
          </a>
        {%- endif -%}
      </div>

      <div class="soy-footer__cols">
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu' -%}
            <div class="soy-fcol" {{ block.shopify_attributes }}>
              <h3 class="soy-fcol__title">{{ block.settings.heading }}</h3>
              <ul class="soy-fcol__list">
                {%- if block.settings.menu != blank -%}
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="soy-footer__bottom">
      <span class="soy-footer__secure">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
        {{ section.settings.secure_text }}
      </span>
      <div class="soy-footer__pay">
        {%- assign pays = section.settings.payments | split: ',' -%}
        {%- for p in pays -%}
          <span class="soy-paybadge">{{ p | strip }}</span>
        {%- endfor -%}
      </div>
      <span class="soy-footer__legal">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
        {%- if section.settings.legal_menu != blank -%}
          {%- for link in section.settings.legal_menu.links -%}
            &middot; <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "SOY Footer",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image (optional)" },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Shades of You" },
    { "type": "text", "id": "logo_subtitle", "label": "Logo subtitle", "default": "Batik · India" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Hand-dyed batik everyday ethnic wear in natural fabrics. Made to measure, made to last." },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp label", "default": "Chat on WhatsApp" },
    { "type": "url", "id": "whatsapp_link", "label": "WhatsApp link" },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "secure_text", "label": "Secure text", "default": "100% secure checkout" },
    { "type": "text", "id": "payments", "label": "Payment badges (comma separated)", "default": "VISA, MASTERCARD, UPI, RUPAY, PAYTM" },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu (Privacy, Terms)" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SOY Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Help" } },
        { "type": "menu", "settings": { "heading": "The Brand" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
