{{ 'soy-product-card.css' | asset_url | stylesheet_tag }}
{{ 'soy-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'soy-wishlist.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'soy-facets.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign active_count = 0
  for filter in collection.filters
    assign active_count = active_count | plus: filter.active_values.size
  endfor
-%}

<section class="soy soy-col">
  <input type="checkbox" id="soy-facets-toggle" class="soy-facets-toggle" aria-hidden="true">

  <div class="soy-container">
    <div class="soy-col__wrap">

      {%- comment %} ---------- Sidebar / drawer facets ---------- {% endcomment -%}
      <aside class="soy-col__sidebar">
        <form method="get" class="soy-facets">
          <div class="soy-facets__chrome">
            <span class="soy-facets__title">Filters</span>
            <label for="soy-facets-toggle" class="soy-facets__close" aria-label="Close filters">
              <svg viewBox="0 0 24 24" stroke-width="1.6"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
            </label>
          </div>

          <span class="soy-facets__heading">
            <svg viewBox="0 0 24 24"><path d="M3 5h18M6 12h12M10 19h4"/></svg>Filters
          </span>

          {%- comment %} preserve current sort when applying filters {% endcomment -%}
          {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
          <input type="hidden" name="sort_by" value="{{ current_sort }}">

          {%- for filter in collection.filters -%}
            {%- assign fname = filter.label | downcase -%}
            <details class="soy-fgroup" open>
              <summary>
                {{ filter.label }}
                <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="soy-fgroup__body">
                {%- case filter.type -%}
                  {%- when 'list' -%}
                    {%- if fname contains 'size' -%}
                      <div class="soy-sizes">
                        {%- for v in filter.values -%}
                          <span class="soy-size">
                            <input type="checkbox" id="f-{{ forloop.index0 }}-{{ filter.param_name }}" name="{{ v.param_name }}" value="{{ v.value }}" {% if v.active %}checked{% endif %} data-soy-facet>
                            <label for="f-{{ forloop.index0 }}-{{ filter.param_name }}">{{ v.label }}</label>
                          </span>
                        {%- endfor -%}
                      </div>

                    {%- elsif fname contains 'colour' or fname contains 'color' -%}
                      <div class="soy-colors">
                        {%- for v in filter.values -%}
                          {%- liquid
                            assign vn = v.label | downcase
                            assign dot = ''
                            if v.swatch.color
                              assign dot = v.swatch.color
                            elsif vn contains 'indigo'
                              assign dot = '#25324D'
                            elsif vn contains 'terracotta'
                              assign dot = '#C25E3A'
                            elsif vn contains 'sage'
                              assign dot = '#8A9A7B'
                            elsif vn contains 'ivory'
                              assign dot = '#F4ECDC'
                            elsif vn contains 'rust'
                              assign dot = '#A84B2B'
                            elsif vn contains 'stone'
                              assign dot = '#6E6557'
                            else
                              assign dot = '#E3D8C2'
                            endif
                          -%}
                          <span class="soy-color">
                            <input type="checkbox" id="f-{{ forloop.index0 }}-{{ filter.param_name }}" name="{{ v.param_name }}" value="{{ v.value }}" {% if v.active %}checked{% endif %} data-soy-facet>
                            <label for="f-{{ forloop.index0 }}-{{ filter.param_name }}">
                              <span class="soy-color__dot" style="background: {{ dot }};"></span>
                              <span class="soy-color__name">{{ v.label }}</span>
                            </label>
                          </span>
                        {%- endfor -%}
                      </div>

                    {%- else -%}
                      <div class="soy-checks">
                        {%- for v in filter.values -%}
                          <label class="soy-check">
                            <input type="checkbox" name="{{ v.param_name }}" value="{{ v.value }}" {% if v.active %}checked{% endif %} data-soy-facet>
                            <span class="soy-check__box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="4 12 10 18 20 6"/></svg></span>
                            <span>{{ v.label }}</span>
                            <span class="soy-check__count">{{ v.count }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}

                  {%- when 'price_range' -%}
                    <div class="soy-checks">
                      <label class="soy-check" style="gap:8px;">
                        <span>Min</span>
                        <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" placeholder="0" class="soy-news__input" style="padding:8px;" data-soy-facet>
                      </label>
                      <label class="soy-check" style="gap:8px;">
                        <span>Max</span>
                        <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" placeholder="{{ filter.range_max | money_without_currency }}" class="soy-news__input" style="padding:8px;" data-soy-facet>
                      </label>
                    </div>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}

          <div class="soy-facets__footer">
            <a href="{{ collection.url }}" class="soy-btn soy-btn--secondary">Clear</a>
            <button type="submit" class="soy-btn soy-btn--primary">Show {{ collection.products_count }} styles</button>
          </div>
        </form>
      </aside>
      <label for="soy-facets-toggle" class="soy-facets__overlay" aria-hidden="true"></label>

      {%- comment %} ---------- Main column ---------- {% endcomment -%}
      <div class="soy-col__main">
        <div class="soy-col__toolbar">
          <div class="soy-col__mbtns">
            <label for="soy-facets-toggle" class="soy-col__mbtn">
              <svg viewBox="0 0 24 24"><path d="M3 5h18M6 12h12M10 19h4"/></svg>
              Filter
              {%- if active_count > 0 -%}<span class="soy-col__mbtn-count">{{ active_count }}</span>{%- endif -%}
            </label>
            {% render 'soy-sort' %}
          </div>

          <div class="soy-col__topbar">
            <span class="soy-col__count">{{ collection.products_count }} styles</span>
            <div class="soy-col__sort-d">{% render 'soy-sort' %}</div>
          </div>

          {%- if active_count > 0 -%}
            <div class="soy-col__active">
              {%- for filter in collection.filters -%}
                {%- for v in filter.active_values -%}
                  <a href="{{ v.url_to_remove }}" class="soy-pill">
                    {{ v.label }}
                    <svg viewBox="0 0 24 24"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
                  </a>
                {%- endfor -%}
              {%- endfor -%}
              <a href="{{ collection.url }}" class="soy-col__clear">Clear all</a>
            </div>
          {%- endif -%}
        </div>

        {%- paginate collection.products by 24 -%}
          {%- if collection.products.size > 0 -%}
            <div class="soy-col__grid">
              {%- for product in collection.products -%}
                {%- render 'soy-product-card', product: product, index: forloop.index0 -%}
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              <nav class="soy-pagination" aria-label="Pagination">
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}">{{ part.title }}</a>
                  {%- else -%}
                    <span class="{% if part.title == paginate.current_page %}is-current{% endif %}">{{ part.title }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </nav>
            {%- endif -%}

          {%- elsif collection.all_products_count == 0 or collection.handle == blank -%}
            {%- comment %} Onboarding demo grid (no products / preview) {% endcomment -%}
            <div class="soy-col__grid">
              {%- render 'soy-product-card-demo', i: 2, name: 'Sage Batik Kurta Set', badge: 'bestseller', rating: '4.9', count: 214, price: '2,499', was: '3,299', off: 24, extra: 'fit', view: 'front', swatches: '#8A9A7B,#25324D,#1F1B16' -%}
              {%- render 'soy-product-card-demo', i: 2, name: 'Bagru Print Co-Ord Set', badge: 'new', active_wish: true, rating: '4.7', count: 86, price: '2,199', was: '2,799', off: 21, extra: 'fit', view: 'side', swatches: '#8A9A7B,#E3D8C2' -%}
              {%- render 'soy-product-card-demo', i: 2, name: 'Sage Dabu Tiered Set', badge: 'custom', rating: '4.8', count: 142, price: '1,899', was: '2,499', off: 24, extra: 'fit', view: 'courtyard', swatches: '#8A9A7B,#25324D' -%}
              {%- render 'soy-product-card-demo', i: 2, name: 'Block-Print Cotton Top', rating: '4.6', count: 58, price: '1,099', was: '1,499', off: 27, extra: 'under', view: 'back', swatches: '#8A9A7B,#E3D8C2' -%}
              {%- render 'soy-product-card-demo', i: 2, name: 'Mul Cotton Wide-Leg Set', badge: 'bestseller', rating: '4.9', count: 176, price: '2,799', was: '3,599', off: 22, extra: 'fit', view: 'front', swatches: '#8A9A7B,#1F1B16' -%}
              {%- render 'soy-product-card-demo', i: 2, name: 'Hand-Dyed Angrakha Kurta', badge: 'custom', rating: '4.8', count: 97, price: '2,399', was: '2,999', off: 20, extra: 'fit', view: 'side', swatches: '#8A9A7B,#25324D' -%}
              {%- render 'soy-product-card-demo', i: 2, name: 'Sage Linen Shirt', rating: '4.5', count: 41, price: '1,249', was: '1,699', off: 26, extra: 'under', view: 'back', swatches: '#8A9A7B,#E3D8C2' -%}
              {%- render 'soy-product-card-demo', i: 2, name: 'Festive Batik Anarkali', badge: 'bestseller', rating: '5', count: 63, price: '3,499', was: '4,299', off: 19, extra: 'low', low_n: 3, view: 'courtyard', swatches: '#8A9A7B,#25324D' -%}
            </div>
          {%- else -%}
            <div class="soy-col__empty">No styles match these filters. <a href="{{ collection.url }}" class="soy-link">Clear all &rsaquo;</a></div>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SOY Collection Grid",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Filters come from your Shopify 'Search & Discovery' settings. Size shows as pills, Color as swatches, others as checkboxes automatically." }
  ],
  "presets": [{ "name": "SOY Collection Grid" }]
}
{% endschema %}
