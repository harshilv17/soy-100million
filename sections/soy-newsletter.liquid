{{ 'soy-community.css' | asset_url | stylesheet_tag }}

<section class="soy soy-news soy-section" style="background: {{ section.settings.bg }};">
  <div class="soy-container">
    <div class="soy-news__inner">
      <h2 class="soy-news__title">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="soy-news__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'soy-news__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="soy-news__note" style="width:100%;">{{ section.settings.success_text }}</p>
        {%- else -%}
          <input
            type="email"
            name="contact[email]"
            class="soy-news__input"
            placeholder="{{ section.settings.placeholder }}"
            required
            aria-label="Email">
          <button type="submit" class="soy-btn soy-btn--primary">{{ section.settings.button_label }}</button>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.note != blank -%}
        <p class="soy-news__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SOY Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Join the inner <em>threads</em>" },
    { "type": "textarea", "id": "text", "label": "Subtext", "default": "First dibs on new batik drops, and 10% off your first order." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get 10% off" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "You're in. Check your inbox for your code." },
    { "type": "text", "id": "note", "label": "Small note (optional)" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ECEFE6" }
  ],
  "presets": [{ "name": "SOY Newsletter" }]
}
{% endschema %}
