{{ 'soy-community.css' | asset_url | stylesheet_tag }}

<section class="soy soy-insta soy-section" style="background: {{ section.settings.bg }};">
  <div class="soy-container">
    <div class="soy-insta__head">
      {%- if section.settings.kicker != blank -%}
        <p class="soy-insta__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      <h2 class="soy-insta__title">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="soy-insta__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="soy-insta__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: section.settings.profile_url }}" class="soy-igtile" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 500 | image_tag: alt: 'Customer photo', loading: 'lazy' }}
          {%- else -%}
            {%- assign phpal = '#25324D,#C25E3A,#8A9A7B,#E3D8C2,#2F3E5C,#EDE6D6' | split: ',' -%}
            {%- assign pidx = forloop.index0 | modulo: 6 -%}
            <span class="soy-igtile__ph" style="background: {{ phpal[pidx] }};">customer · {{ forloop.index }}</span>
          {%- endif -%}
          <span class="soy-igtile__cart" aria-hidden="true">
            <svg viewBox="0 0 24 24" stroke-width="1.7"><path d="M6 7h12l-1 13H7L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
          </span>
        </a>
      {%- endfor -%}
    </div>

    <div class="soy-insta__follow">
      <span class="soy-insta__handle">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" style="color:var(--soy-indigo)"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
        {{ section.settings.handle }} <small>{{ section.settings.followers }}</small>
      </span>
      <a href="{{ section.settings.profile_url }}" class="soy-btn soy-btn--secondary soy-btn--sm" target="_blank" rel="noopener">{{ section.settings.follow_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SOY Instagram",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "#ShadesOfYou" },
    { "type": "text", "id": "title", "label": "Title", "default": "As worn by <em>you</em>" },
    { "type": "text", "id": "text", "label": "Subtext", "default": "Tag us — real customers, real fabric, shoppable." },
    { "type": "text", "id": "handle", "label": "Handle", "default": "@shadesofyou" },
    { "type": "text", "id": "followers", "label": "Followers", "default": "87.4k followers" },
    { "type": "text", "id": "follow_label", "label": "Button label", "default": "Follow on Instagram" },
    { "type": "url", "id": "profile_url", "label": "Profile URL" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FAF5EC" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link (product / post)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SOY Instagram",
      "blocks": [
        { "type": "post" }, { "type": "post" }, { "type": "post" },
        { "type": "post" }, { "type": "post" }, { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
