{%- comment -%}
  SOY cart drawer. Soy-styled but preserves every Dawn cart JS hook:
  custom elements (cart-drawer, cart-drawer-items, cart-remove-button, quantity-input),
  ids (#CartDrawer, #CartDrawer-Overlay, .drawer__inner, #CartDrawer-Form,
  #CartDrawer-CartItems.js-contents, #CartDrawer-Item-N, Drawer-quantity-N,
  #CartDrawer-Remove-N, #CartDrawer-LineItemError-N, #CartDrawer-Checkout,
  #CartDrawer-LiveRegionText, #CartDrawer-LineItemStatus, #CartDrawer-CartErrors).
  Edit FREE SHIPPING threshold below (cents).
{%- endcomment -%}
{{ 'soy-cart-drawer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer { visibility: hidden; }
</style>

{%- liquid
  assign free_threshold = 99900
  assign remaining = free_threshold | minus: cart.total_price
  assign ship_pct = cart.total_price | times: 100 | divided_by: free_threshold
  if ship_pct > 100
    assign ship_pct = 100
  endif
-%}

<cart-drawer class="drawer soy-cd{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner soy-cd__inner{% if cart == empty %} is-empty{% endif %}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      <div class="soy-cd__head">
        <h2 class="soy-cd__title">Your bag <span>({{ cart.item_count }})</span></h2>
        <button class="drawer__close soy-cd__close" type="button" onclick="this.closest('cart-drawer').close()" aria-label="{{ 'accessibility.close' | t }}">
          <svg viewBox="0 0 24 24" stroke-width="1.7" fill="none" stroke="currentColor"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      {%- if cart == empty -%}
        <div class="drawer__inner-empty soy-cd__empty">
          <p class="soy-cd__empty-txt">Your bag is empty.</p>
          <a href="{{ routes.all_products_collection_url }}" class="soy-cd__continue">Continue shopping</a>
        </div>
      {%- else -%}
        <div class="soy-cd__body">
          {%- if remaining <= 0 -%}
            <div class="soy-cd__ship soy-cd__ship--done">
              <div class="soy-cd__ship-row">
                <svg viewBox="0 0 24 24" stroke-width="1.8" fill="none" stroke="currentColor"><path d="M5 12l4 4L19 6"/></svg>
                <span>You've unlocked <b>free shipping</b></span>
              </div>
              <div class="soy-cd__bar"><span style="width:100%"></span></div>
            </div>
          {%- else -%}
            <div class="soy-cd__ship">
              <div class="soy-cd__ship-row">
                <span>Add <b>{{ remaining | money }}</b> more for <b>free shipping</b></span>
              </div>
              <div class="soy-cd__bar"><span style="width:{{ ship_pct }}%"></span></div>
            </div>
          {%- endif -%}

          <cart-drawer-items class="soy-cd__items">
            <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="cart__contents cart-drawer__form" method="post">
              <div id="CartDrawer-CartItems" class="js-contents soy-cd__list">
                {%- for item in cart.items -%}
                  {%- liquid
                    assign idx = item.index | plus: 1
                    assign citem_on_sale = false
                    if item.variant.compare_at_price > item.variant.price
                      assign citem_on_sale = true
                      assign citem_off = item.variant.compare_at_price | minus: item.variant.price | times: 100.0 | divided_by: item.variant.compare_at_price | round
                    endif
                  -%}
                  <div id="CartDrawer-Item-{{ idx }}" class="cart-item soy-citem" data-index="{{ idx }}">
                    <a href="{{ item.url }}" class="soy-citem__media" tabindex="-1" aria-hidden="true">
                      {%- if item.image -%}
                        <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" loading="lazy" width="100" height="{{ 100 | divided_by: item.image.aspect_ratio | ceil }}">
                      {%- endif -%}
                    </a>

                    <div class="soy-citem__main">
                      <div class="soy-citem__top">
                        <a href="{{ item.url }}" class="soy-citem__name">{{ item.product.title | escape }}</a>
                        <cart-remove-button id="CartDrawer-Remove-{{ idx }}" data-index="{{ idx }}">
                          <button type="button" class="soy-citem__remove" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}" data-variant-id="{{ item.variant.id }}">
                            <svg viewBox="0 0 24 24" stroke-width="1.6" fill="none" stroke="currentColor"><path d="M6 6l12 12M18 6L6 18"/></svg>
                          </button>
                        </cart-remove-button>
                      </div>

                      {%- if item.product.has_only_default_variant == false -%}
                        <div class="soy-citem__opts">
                          {%- for option in item.options_with_values -%}
                            {%- if option.name contains 'Size' %}Size {% endif %}{{ option.value }}{%- unless forloop.last %} · {% endunless -%}
                          {%- endfor -%}
                        </div>
                      {%- endif -%}

                      {%- assign mtm = '' -%}
                      {%- for property in item.properties -%}
                        {%- assign pchar = property.first | slice: 0 -%}
                        {%- if property.last != blank and pchar != '_' -%}
                          {%- if property.first == 'Made-to-measure' -%}
                            {%- capture mtm -%}{{ mtm }}{% unless mtm == '' %} · {% endunless %}Made-to-measure{%- endcapture -%}
                          {%- else -%}
                            {%- capture mtm -%}{{ mtm }}{% unless mtm == '' %} · {% endunless %}{{ property.first }} {{ property.last }}{%- endcapture -%}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if mtm != blank -%}
                        <div class="soy-citem__pill">
                          <svg viewBox="0 0 24 24" stroke-width="1.6" fill="none" stroke="currentColor"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4L8.5 15.5M14.5 14.5L20 20"/></svg>
                          {{ mtm }}
                        </div>
                      {%- endif -%}

                      <div class="soy-citem__row">
                        <quantity-input class="soy-qty">
                          <button class="soy-qty__btn" name="minus" type="button" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}">
                            <svg viewBox="0 0 24 24" stroke-width="1.8" fill="none" stroke="currentColor"><path d="M5 12h14"/></svg>
                          </button>
                          <input
                            class="soy-qty__input"
                            type="number"
                            name="updates[]"
                            value="{{ item.quantity }}"
                            min="0"
                            data-index="{{ idx }}"
                            data-quantity-variant-id="{{ item.variant.id }}"
                            id="Drawer-quantity-{{ idx }}"
                            aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                          >
                          <button class="soy-qty__btn" name="plus" type="button" aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}">
                            <svg viewBox="0 0 24 24" stroke-width="1.8" fill="none" stroke="currentColor"><path d="M12 5v14M5 12h14"/></svg>
                          </button>
                        </quantity-input>

                        <div class="soy-citem__price">
                          {%- render 'loading-spinner' -%}
                          <span class="soy-citem__now">{{ item.final_price | money }}</span>
                          {%- if citem_on_sale -%}
                            <s class="soy-citem__was">{{ item.variant.compare_at_price | money }}</s>
                            <span class="soy-citem__off">{{ citem_off }}% off</span>
                          {%- endif -%}
                        </div>
                      </div>

                      <div id="CartDrawer-LineItemError-{{ idx }}" class="cart-item__error soy-citem__error" role="alert">
                        <small class="cart-item__error-text"></small>
                      </div>
                    </div>
                  </div>
                {%- endfor -%}

                <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
                <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">{{ 'accessibility.loading' | t }}</p>
              </div>
              <div id="CartDrawer-CartErrors" class="soy-cd__errors" role="alert"></div>
            </form>
          </cart-drawer-items>

          <p class="soy-cd__returns">
            <svg viewBox="0 0 24 24" stroke-width="1.5" fill="none" stroke="currentColor"><path d="M3 12a9 9 0 0 1 15-6.7L21 8M21 12a9 9 0 0 1-15 6.7L3 16M21 4v4h-4M3 20v-4h4"/></svg>
            Easy 7-day returns on standard sizes. Made-to-measure pieces are final sale.
          </p>
        </div>

        <div class="drawer__footer soy-cd__foot">
          <div class="soy-cd__subtotal">
            <span>Subtotal</span>
            <span class="soy-cd__sub-val">{{ cart.total_price | money }}</span>
          </div>
          <button type="submit" id="CartDrawer-Checkout" class="soy-cd__checkout" name="checkout" form="CartDrawer-Form"{% if cart == empty %} disabled{% endif %}>
            <svg viewBox="0 0 24 24" stroke-width="1.6" fill="none" stroke="currentColor"><path d="M12 3l7 3v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3Z"/><path d="M9.2 12l2 2 3.6-3.8"/></svg>
            Secure checkout
          </button>
          <div class="soy-cd__secure">
            <svg viewBox="0 0 24 24" stroke-width="1.6" fill="none" stroke="currentColor"><path d="M12 3l7 3v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3Z"/><path d="M9.2 12l2 2 3.6-3.8"/></svg>
            100% secure checkout
          </div>
          <div class="soy-cd__pays">
            <span class="soy-pay">UPI</span><span class="soy-pay">Visa</span><span class="soy-pay">Mastercard</span><span class="soy-pay">RuPay</span><span class="soy-pay">Razorpay</span>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</cart-drawer>
